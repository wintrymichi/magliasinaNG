<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ticino Server: the Windows app of the Ticino map (beamng/ticino/gui/README.md). WPF with the Fluent theme of
       Windows 11 (.NET 10). Published as one self-contained exe (.github/workflows/ticino_gui.yml): nothing to
       install on the PC. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TicinoServer</AssemblyName>
    <RootNamespace>TicinoServer</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.2</Version>
    <!-- the workflow sets InformationalVersion <Version>+<short sha>: without this the SDK added the full sha again -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Ticino Server</Product>
    <Company>MagliasinaNG</Company>
    <Copyright>CC BY-NC 4.0</Copyright>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- ThemeMode (the Fluent theme) is marked experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>it;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <!-- the launcher of beamng/ticino/install: put into ticino_tools when the installer's one predates the server mode
       (Core/Installer.cs UpdateLauncher) -->
  <ItemGroup>
    <EmbeddedResource Include="..\install\start_ticino.ps1" LogicalName="start_ticino.ps1" />
    <EmbeddedResource Include="..\install\Start Ticino.bat" LogicalName="Start Ticino.bat" />
  </ItemGroup>

</Project>
