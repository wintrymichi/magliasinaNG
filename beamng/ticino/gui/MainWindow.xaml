<Window x:Class="TicinoServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ticino Server" Width="1120" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- navigation -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="22,22,16,22">
                <Image Source="Assets/logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Ticino Server" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="MagliasinaNG · BeamNG" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <ListBox x:Name="Nav" Grid.Row="1" Margin="8,0,8,0" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Nav_SelectionChanged">
                <!-- as the NavigationView of Windows 11: a quiet fill and an accent pill on the selected item -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="Bg" CornerRadius="4" Background="Transparent" />
                                        <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBoxItem Tag="home" Padding="12,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Margin="0,0,14,0" />
                        <TextBlock Text="Home" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="graphics" Padding="12,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Margin="0,0,14,0" />
                        <TextBlock Text="Grafica" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="download" Padding="12,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,14,0" />
                        <TextBlock Text="Download" FontSize="14" VerticalAlignment="Center" />
                        <Border x:Name="NavBadge" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="8"
                                Padding="6,0" Margin="8,0,0,0" MinWidth="16" Height="16" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock x:Name="NavBadgeText" FontSize="11" Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="server" Padding="12,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" Margin="0,0,14,0" />
                        <TextBlock Text="Server" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="about" Padding="12,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,14,0" />
                        <TextBlock Text="Informazioni" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- server state, always in sight -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="12,8,12,14" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,5,12,0" VerticalAlignment="Top"
                             Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StatusTitle" Text="Server fermo" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="StatusLine" Text="BeamNG chiuso" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- page -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ContentControl x:Name="Page" Focusable="False" />
        </Border>
    </Grid>
</Window>
