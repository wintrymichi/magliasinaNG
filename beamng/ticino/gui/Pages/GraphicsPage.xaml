<UserControl x:Class="TicinoServer.Pages.GraphicsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TicinoServer.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,30,40,40" MaxWidth="1000">
            <TextBlock Text="Grafica" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource SubtitleText}"
                       Text="Quanto lontano la mappa disegna alberi, edifici, strade e terreno. Le modifiche si salvano da sole e valgono dal prossimo caricamento della mappa." />

            <c:InfoBar x:Name="SavedBar" Severity="Success" Visibility="Collapsed" />

            <c:SettingCard Glyph="&#xE790;" Header="Qualità"
                           Description="Alta è la mappa come è stata costruita e provata. Media e Bassa per PC con poca memoria video o un processore lento: la scena vicina (strade, edifici, collisioni) resta la stessa.">
                <ComboBox x:Name="QualityBox" Width="200" SelectionChanged="Quality_Changed">
                    <ComboBoxItem Content="Bassa" Tag="Low" />
                    <ComboBoxItem Content="Media" Tag="Medium" />
                    <ComboBoxItem Content="Alta (consigliata)" Tag="High" />
                    <ComboBoxItem Content="Personalizzata" Tag="Custom" />
                </ComboBox>
            </c:SettingCard>

            <TextBlock Text="Distanza visiva" Style="{StaticResource SectionText}" />
            <c:SettingCard Glyph="&#xE913;" Header="Alberi"
                           Description="Fino a che distanza dall'auto ci sono gli alberi. Ogni passo è una tile di 384 m.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ForestText" Style="{StaticResource ValueText}" />
                    <Slider x:Name="Forest" Minimum="1" Maximum="4" Width="220" IsSnapToTickEnabled="True" TickFrequency="1"
                            TickPlacement="BottomRight" ValueChanged="Slider_Changed" />
                </StackPanel>
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE909;" Header="Terreno lontano"
                           Description="Le montagne e le valli oltre i 3 km del terreno vicino (senza collisioni, solo da vedere).">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FarText" Style="{StaticResource ValueText}" />
                    <Slider x:Name="Far" Minimum="4" Maximum="16" Width="220" IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="Slider_Changed" />
                </StackPanel>
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE80F;" Header="Edifici"
                           Description="Case, chiese, capannoni.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="BuildingsText" Style="{StaticResource ValueText}" />
                    <Slider x:Name="Buildings" Minimum="2" Maximum="6" Width="220" IsSnapToTickEnabled="True" TickFrequency="1"
                            TickPlacement="BottomRight" ValueChanged="Slider_Changed" />
                </StackPanel>
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE804;" Header="Strade, muri e ferrovia"
                           Description="Anche le gallerie e le scarpate rocciose lungo le strade.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="RoadsText" Style="{StaticResource ValueText}" />
                    <Slider x:Name="Roads" Minimum="2" Maximum="5" Width="220" IsSnapToTickEnabled="True" TickFrequency="1"
                            TickPlacement="BottomRight" ValueChanged="Slider_Changed" />
                </StackPanel>
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE81E;" Header="Dettagli"
                           Description="Arredo urbano, paletti, vetrine, segnaletica orizzontale, dettagli delle case.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="DetailsText" Style="{StaticResource ValueText}" />
                    <Slider x:Name="Details" Minimum="0" Maximum="2" Width="220" IsSnapToTickEnabled="True" TickFrequency="1"
                            TickPlacement="BottomRight" ValueChanged="Slider_Changed" />
                </StackPanel>
            </c:SettingCard>
            <TextBlock Style="{StaticResource CaptionText}" Margin="2,6,0,0"
                       Text="Gli oggetti non possono essere disegnati più lontano di come è costruita la mappa: Alta è già il massimo." />

            <TextBlock Text="Prestazioni" Style="{StaticResource SectionText}" />
            <c:SettingCard Glyph="&#xE9F5;" Header="Helper"
                           Description="Prepara il terreno su un altro core del processore mentre guidi (con il server attivo lo fa il server).">
                <CheckBox x:Name="Helper" Content="Attivo" Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
            </c:SettingCard>

            <Expander Margin="0,4,0,4" Padding="0,8,0,0">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,8">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="20" Margin="0,0,18,0" />
                        <StackPanel>
                            <TextBlock Text="Avanzate" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Valori misurati sul PC di prova (ottobre 2026): cambiali solo per provare." Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </StackPanel>
                </Expander.Header>
                <StackPanel>
                    <c:SettingCard Header="Intervallo tra le raffiche di oggetti"
                                   Description="Oggetti, alberi e terreno lontano arrivano a raffiche: poche e brevi pesano meno di tante.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BurstEveryText" Style="{StaticResource ValueText}" />
                            <Slider x:Name="BurstEvery" Minimum="200" Maximum="2000" Width="220" IsSnapToTickEnabled="True"
                                    TickFrequency="100" ValueChanged="Slider_Changed" />
                        </StackPanel>
                    </c:SettingCard>
                    <c:SettingCard Header="Durata di una raffica">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BurstText" Style="{StaticResource ValueText}" />
                            <Slider x:Name="Burst" Minimum="5" Maximum="60" Width="220" IsSnapToTickEnabled="True"
                                    TickFrequency="5" ValueChanged="Slider_Changed" />
                        </StackPanel>
                    </c:SettingCard>
                    <c:SettingCard Header="Alberi cambiati insieme"
                                   Description="Le tile di N x N condividono una foresta: meno cambi, ognuno costa ~200 ms al motore.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BlockText" Style="{StaticResource ValueText}" />
                            <Slider x:Name="Block" Minimum="1" Maximum="4" Width="220" IsSnapToTickEnabled="True"
                                    TickFrequency="1" TickPlacement="BottomRight" ValueChanged="Slider_Changed" />
                        </StackPanel>
                    </c:SettingCard>
                    <c:SettingCard Header="Isteresi degli alberi"
                                   Description="Gli alberi di una tile restano fino a N anelli oltre il loro raggio.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="HystText" Style="{StaticResource ValueText}" />
                            <Slider x:Name="Hyst" Minimum="0" Maximum="2" Width="220" IsSnapToTickEnabled="True"
                                    TickFrequency="1" TickPlacement="BottomRight" ValueChanged="Slider_Changed" />
                        </StackPanel>
                    </c:SettingCard>
                    <c:SettingCard Header="Diagnostica"
                                   Description="Scrive ticino_perf.csv e ticino_frames.csv nella cartella utente di BeamNG.">
                        <CheckBox x:Name="Diagnostics" Content="Attiva" Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                    </c:SettingCard>
                </StackPanel>
            </Expander>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="Ripristina i valori consigliati" Click="Reset_Click" Padding="14,6" />
                <Button Content="Apri il file delle impostazioni" Click="OpenFile_Click" Padding="14,6" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
