<UserControl x:Class="TicinoServer.Pages.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TicinoServer.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,30,40,40" MaxWidth="1000">
            <TextBlock Text="Download e aggiornamenti" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource SubtitleText}"
                       Text="I pacchetti della mappa arrivano dalla release di GitHub. Si scarica solo quello che è cambiato, un download interrotto riprende da dove si è fermato e ogni zip è controllato con il suo sha256." />

            <c:InfoBar x:Name="ErrorBar" Severity="Error" Title="Controllo non riuscito" Visibility="Collapsed">
                <Button Content="Riprova" Click="Check_Click" />
            </c:InfoBar>
            <c:InfoBar x:Name="FolderBar" Severity="Warning" Title="Scegli dove salvare la mappa" Visibility="Collapsed"
                       Message="Le zone occupano circa 52 GB. Il disco più capiente di questo PC è già proposto qui sotto.">
                <Button Content="Usa questa cartella" Click="UseSuggested_Click" />
            </c:InfoBar>
            <c:InfoBar x:Name="ReadyBar" Severity="Info" Title="Aggiornamenti scaricati" Visibility="Collapsed">
                <Button Content="Installa ora" Click="Apply_Click" />
            </c:InfoBar>

            <!-- the release and the big button -->
            <Border Style="{StaticResource Card}" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock x:Name="ReleaseTitle" Text="Release" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="SummaryText" Style="{StaticResource BodyText}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="LastCheckText" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="CheckButton" Click="Check_Click" Padding="14,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Controlla" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DownloadButton" Click="Download_Click" Padding="18,6"
                                Style="{DynamicResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DownloadGlyph" Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock x:Name="DownloadLabel" Text="Scarica" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" x:Name="ProgressPanel" Margin="0,18,0,0" Visibility="Collapsed">
                        <ProgressBar x:Name="Overall" Height="4" Maximum="100" />
                        <TextBlock x:Name="ProgressText" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Dove" Style="{StaticResource SectionText}" />
            <c:SettingCard Glyph="&#xE8B7;" Header="Cartella dei pacchetti zona"
                           x:Name="DataCard">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Apri" Click="OpenData_Click" Padding="14,6" Margin="0,0,8,0" />
                    <Button Content="Cambia…" Click="ChangeData_Click" Padding="14,6" />
                </StackPanel>
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE7B8;" Header="Pacchetto base" x:Name="BaseCard"
                           Description="Il pacchetto base (scena, materiali, mod) va nella cartella mods di BeamNG." />
            <c:SettingCard Glyph="&#xE77B;" Header="Release" Description="Il tag della release su GitHub da cui scaricare.">
                <TextBox x:Name="TagBox" Width="200" LostFocus="Tag_LostFocus" KeyDown="Tag_KeyDown" />
            </c:SettingCard>

            <TextBlock Text="Aggiornamenti automatici" Style="{StaticResource SectionText}" />
            <c:SettingCard Glyph="&#xE895;" Header="Controlla gli aggiornamenti all'avvio"
                           Description="E ogni 6 ore mentre l'app è aperta.">
                <CheckBox x:Name="CheckOnStart" Content="Attivo" Click="Options_Click" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE896;" Header="Scarica gli aggiornamenti da solo"
                           Description="Gli zip nuovi si installano quando server e gioco sono chiusi: mentre giochi non cambia niente.">
                <CheckBox x:Name="AutoDownload" Content="Attivo" Click="Options_Click" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE74D;" Header="Elimina i pacchetti vecchi"
                           Description="Altrimenti finiscono nella cartella old dentro la cartella dei pacchetti.">
                <CheckBox x:Name="DeleteOld" Content="Attivo" Click="Options_Click" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE9F5;" Header="Download in parallelo">
                <ComboBox x:Name="Parallel" Width="90" SelectionChanged="Parallel_Changed">
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="2" />
                    <ComboBoxItem Content="3" />
                    <ComboBoxItem Content="4" />
                    <ComboBoxItem Content="6" />
                </ComboBox>
            </c:SettingCard>

            <Grid Margin="0,22,0,8">
                <TextBlock Text="Pacchetti" Style="{StaticResource SectionText}" Margin="1,0,0,0" />
                <CheckBox x:Name="OnlyPending" Content="Solo quelli da scaricare" HorizontalAlignment="Right"
                          Click="Filter_Click" />
            </Grid>
            <Border Style="{StaticResource Card}" Padding="0">
                <ItemsControl x:Name="List" Margin="0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="20,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Margin="0,0,16,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="3" Margin="0,6,0,0"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource CaptionText}"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock x:Name="EmptyText" Style="{StaticResource CaptionText}" Margin="2,8,0,0"
                       Text="Premi Controlla per leggere la release." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
