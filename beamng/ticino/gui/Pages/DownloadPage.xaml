<UserControl x:Class="TicinoServer.Pages.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TicinoServer.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,30,40,40" MaxWidth="1000">
            <TextBlock Text="Downloads and updates" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource SubtitleText}"
                       Text="The map packs come from the GitHub release. Only what changed is downloaded, an interrupted download resumes where it stopped, and every zip is checked against its sha256." />

            <c:InfoBar x:Name="ErrorBar" Severity="Error" Title="Check failed" Visibility="Collapsed">
                <Button Content="Retry" Click="Check_Click" />
            </c:InfoBar>
            <c:InfoBar x:Name="FolderBar" Severity="Warning" Title="Choose where to keep the map" Visibility="Collapsed"
                       Message="The zones take about 52 GB. The drive with the most room on this PC is suggested below.">
                <Button Content="Use this folder" Click="UseSuggested_Click" />
            </c:InfoBar>
            <c:InfoBar x:Name="ReadyBar" Severity="Info" Title="Updates downloaded" Visibility="Collapsed">
                <Button Content="Install now" Click="Apply_Click" />
            </c:InfoBar>

            <!-- the release and the big button -->
            <Border Style="{StaticResource Card}" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock x:Name="ReleaseTitle" Text="Release" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="SummaryText" Style="{StaticResource BodyText}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="LastCheckText" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="CheckButton" Click="Check_Click" Padding="14,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Check" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DownloadButton" Click="Download_Click" Padding="18,6"
                                Style="{DynamicResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DownloadGlyph" Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock x:Name="DownloadLabel" Text="Download" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" x:Name="ProgressPanel" Margin="0,18,0,0" Visibility="Collapsed">
                        <ProgressBar x:Name="Overall" Height="4" Maximum="100" />
                        <TextBlock x:Name="ProgressText" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Where" Style="{StaticResource SectionText}" />
            <c:SettingCard Glyph="&#xE8B7;" Header="Zone packs folder"
                           x:Name="DataCard">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Open" Click="OpenData_Click" Padding="14,6" Margin="0,0,8,0" />
                    <Button Content="Change…" Click="ChangeData_Click" Padding="14,6" />
                </StackPanel>
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE7B8;" Header="Base pack" x:Name="BaseCard"
                           Description="The base pack (scene, materials, mod) goes into BeamNG's mods folder." />
            <c:SettingCard Glyph="&#xE77B;" Header="Release" Description="The tag of the GitHub release to download from.">
                <TextBox x:Name="TagBox" Width="200" LostFocus="Tag_LostFocus" KeyDown="Tag_KeyDown" />
            </c:SettingCard>

            <TextBlock Text="Automatic updates" Style="{StaticResource SectionText}" />
            <c:SettingCard Glyph="&#xE895;" Header="Check for updates at start"
                           Description="And every 6 hours while the app is open.">
                <CheckBox x:Name="CheckOnStart" Content="On" Click="Options_Click" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE896;" Header="Download updates automatically"
                           Description="New zips are installed when the server and the game are closed: nothing changes while you play.">
                <CheckBox x:Name="AutoDownload" Content="On" Click="Options_Click" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE74D;" Header="Delete old packs"
                           Description="Otherwise they go to the old folder inside the packs folder.">
                <CheckBox x:Name="DeleteOld" Content="On" Click="Options_Click" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE9F5;" Header="Parallel downloads">
                <ComboBox x:Name="Parallel" Width="90" SelectionChanged="Parallel_Changed">
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="2" />
                    <ComboBoxItem Content="3" />
                    <ComboBoxItem Content="4" />
                    <ComboBoxItem Content="6" />
                </ComboBox>
            </c:SettingCard>

            <Grid Margin="0,22,0,8">
                <TextBlock Text="Packs" Style="{StaticResource SectionText}" Margin="1,0,0,0" />
                <CheckBox x:Name="OnlyPending" Content="Only those to download" HorizontalAlignment="Right"
                          Click="Filter_Click" />
            </Grid>
            <Border Style="{StaticResource Card}" Padding="0">
                <ItemsControl x:Name="List" Margin="0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="20,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Margin="0,0,16,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="3" Margin="0,6,0,0"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource CaptionText}"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock x:Name="EmptyText" Style="{StaticResource CaptionText}" Margin="2,8,0,0"
                       Text="Press Check to read the release." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
