<UserControl x:Class="TicinoServer.Pages.ServerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TicinoServer.Controls">
    <Grid Margin="40,30,40,30" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="520">
            <StackPanel>
                <TextBlock Text="Server" Style="{StaticResource TitleText}" />
                <TextBlock Style="{StaticResource SubtitleText}"
                           Text="Il server legge le zone dalla cartella dei pacchetti, converte le forme delle tile intorno all'auto e le scrive nella cartella temp di BeamNG, dove il gioco le carica come la sua cache." />

                <c:InfoBar x:Name="LuaBar" Severity="Warning" Title="Lua di prova del server" Visibility="Collapsed">
                    <Button x:Name="LuaButton" Content="Installa" Click="Lua_Click" />
                </c:InfoBar>

                <c:SettingCard Glyph="&#xE7B8;" Header="Spazio per le tile pronte"
                               Description="Quanto il server tiene nella cartella temp di BeamNG; oltre, toglie le tile più lontane dall'auto.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CacheText" Style="{StaticResource ValueText}" />
                        <Slider x:Name="Cache" Minimum="2" Maximum="32" Width="220" IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="Changed" />
                    </StackPanel>
                </c:SettingCard>
                <c:SettingCard Glyph="&#xE950;" Header="Processi di conversione"
                               Description="Core del processore che convertono le forme. Lasciane liberi almeno due per il gioco.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="WorkersText" Style="{StaticResource ValueText}" />
                        <Slider x:Name="Workers" Minimum="1" Maximum="8" Width="220" IsSnapToTickEnabled="True" TickFrequency="1"
                                TickPlacement="BottomRight" ValueChanged="Changed" />
                    </StackPanel>
                </c:SettingCard>
                <c:SettingCard Glyph="&#xE909;" Header="Finestre di terreno pronte in anticipo"
                               Description="Le prossime posizioni del terreno che il server tiene pronte (1-8).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AheadText" Style="{StaticResource ValueText}" />
                        <Slider x:Name="Ahead" Minimum="1" Maximum="8" Width="220" IsSnapToTickEnabled="True" TickFrequency="1"
                                TickPlacement="BottomRight" ValueChanged="Changed" />
                    </StackPanel>
                </c:SettingCard>
                <c:SettingCard Glyph="&#xE8B9;" Header="Forme già convertite (.cdae)"
                               Description="Il gioco non deve leggere i Collada né farsi la sua cache. Spento solo per prove.">
                    <CheckBox x:Name="Cdae" Content="Attivo" Click="Toggle" />
                </c:SettingCard>

                <TextBlock Text="Avvio" Style="{StaticResource SectionText}" />
                <c:SettingCard Glyph="&#xE7FC;" Header="Avvia il server con Gioca" Description="E fermalo quando BeamNG si chiude.">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="WithGame" Content="Avvia" Click="Toggle" Margin="0,0,16,0" />
                        <CheckBox x:Name="StopWithGame" Content="Ferma" Click="Toggle" />
                    </StackPanel>
                </c:SettingCard>
                <c:SettingCard Glyph="&#xE768;" Header="Avvia il server all'apertura dell'app">
                    <CheckBox x:Name="WithApp" Content="Attivo" Click="Toggle" />
                </c:SettingCard>
                <c:SettingCard Glyph="&#xE895;" Header="Aggiorna anche il programma del server"
                               Description="server_ticino.zip della stessa release.">
                    <CheckBox x:Name="UpdateServer" Content="Attivo" Click="Toggle" />
                </c:SettingCard>
                <c:SettingCard x:Name="ExeCard" Glyph="&#xE756;" Header="Programma del server">
                    <Button Content="Apri cartella" Click="OpenExe_Click" Padding="14,6" />
                </c:SettingCard>
                <TextBlock x:Name="RestartText" Style="{StaticResource CaptionText}" Margin="2,6,0,0" Visibility="Collapsed"
                           Text="Valgono dal prossimo avvio del server." />

                <Grid Margin="0,22,0,8">
                    <TextBlock Text="Registro" Style="{StaticResource SectionText}" Margin="1,0,0,0" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Copia" Click="Copy_Click" Padding="12,4" Margin="0,0,8,0" />
                        <Button Content="Svuota" Click="Clear_Click" Padding="12,4" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 AcceptsReturn="True" Padding="10,8" />
    </Grid>
</UserControl>
