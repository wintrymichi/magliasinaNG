<UserControl x:Class="TicinoServer.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TicinoServer.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,30,40,40" MaxWidth="1000">
            <TextBlock Text="Informazioni" Style="{StaticResource TitleText}" />
            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,12,0,4">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/logo.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Ticino Server" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="Parte di MagliasinaNG · licenza CC BY-NC 4.0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <c:SettingCard Glyph="&#xE71B;" Header="Progetto su GitHub" Description="github.com/wintrymichi/magliasinaNG">
                <Button Content="Apri" Click="Repo_Click" Padding="14,6" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE8A5;" Header="Guida della mappa Ticino" Description="Installazione, impostazioni, come funziona lo streaming.">
                <Button Content="Apri" Click="Readme_Click" Padding="14,6" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE9F9;" Header="Registro dell'app" Description="Per segnalare un problema: app.log nella cartella dell'app.">
                <Button Content="Apri cartella" Click="Logs_Click" Padding="14,6" />
            </c:SettingCard>
            <TextBlock Text="Crediti" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}">
                <TextBlock Style="{StaticResource BodyText}" LineHeight="22"
                           Text="Dati: swisstopo (swissALTI3D, swissBUILDINGS3D, swissTLM3D), misurazione ufficiale del Canton Ticino, contributori di OpenStreetMap. Lo scambio del terreno, gli oggetti in tempo reale e il formato .cdae seguono BeamNG.Earth (TecnaGamer, MIT). BeamNG.drive è un marchio di BeamNG GmbH; questo programma non è affiliato a BeamNG." />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
