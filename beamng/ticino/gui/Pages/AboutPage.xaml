<UserControl x:Class="TicinoServer.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TicinoServer.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,30,40,40" MaxWidth="1000">
            <TextBlock Text="About" Style="{StaticResource TitleText}" />
            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,12,0,4">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/logo.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Ticino Server" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="Part of MagliasinaNG · licence CC BY-NC 4.0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <c:SettingCard Glyph="&#xE71B;" Header="Project on GitHub" Description="github.com/wintrymichi/magliasinaNG">
                <Button Content="Open" Click="Repo_Click" Padding="14,6" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE8A5;" Header="Ticino map guide" Description="Installation, settings, how the streaming works.">
                <Button Content="Open" Click="Readme_Click" Padding="14,6" />
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE9F9;" Header="App log" Description="To report a problem: app.log in the app's folder.">
                <Button Content="Open folder" Click="Logs_Click" Padding="14,6" />
            </c:SettingCard>
            <TextBlock Text="Credits" Style="{StaticResource SectionText}" />
            <Border Style="{StaticResource Card}">
                <TextBlock Style="{StaticResource BodyText}" LineHeight="22"
                           Text="Data: swisstopo (swissALTI3D, swissBUILDINGS3D, swissTLM3D), official cadastral survey of Canton Ticino, OpenStreetMap contributors. The terrain swap, the runtime objects and the .cdae format follow BeamNG.Earth (TecnaGamer, MIT). BeamNG.drive is a trademark of BeamNG GmbH; this program is not affiliated with BeamNG." />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
